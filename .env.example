# Optional overrides for docker-compose.yml. Copy to .env and uncomment as needed.
# Everything has a working dev default except the Textract keys.

# Local MinIO credentials, also used by the api and worker as the S3 keys.
#MINIO_ROOT_USER=minioadmin
#MINIO_ROOT_PASSWORD=minioadmin
#MINIO_BROWSER_REDIRECT_URL=http://localhost:10001

# Signs login sessions. Must be 32 characters or longer.
#SESSION_SECRET=dev-only-session-secret-not-for-production

# Real AWS credentials for Textract OCR. OCR fails without them.
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
