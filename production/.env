# This file is committed to git as a template. The deploy script renders it
# (via envsubst) using values from the operator-local `env` file, then rsyncs
# the rendered version to the server where docker compose auto-loads it.
#
# Do NOT put real values here. Edit `env` (gitignored) on your machine instead.

# Domain — apex hostname of this deployment
DOMAIN=${DOMAIN}

# Let's Encrypt registration email
ACME_EMAIL=${ACME_EMAIL}

# Postgres
DB_PASSWORD=${DB_PASSWORD}

# Internal seaweedfs (S3) credentials
S3_ACCESS_KEY_ID=${S3_ACCESS_KEY_ID}
S3_SECRET_ACCESS_KEY=${S3_SECRET_ACCESS_KEY}

# Real AWS (SES + Textract)
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
AWS_REGION=${AWS_REGION}

# UI / API secrets
MAPBOX_TOKEN=${MAPBOX_TOKEN}
SESSION_SECRET=${SESSION_SECRET}

# Administrator emails — JSON array literal
ADMINISTRATORS=${ADMINISTRATORS}

# SES
SES_SOURCE_EMAIL=${SES_SOURCE_EMAIL}
SES_REPLY_TO=${SES_REPLY_TO}
