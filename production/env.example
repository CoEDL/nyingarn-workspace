# Copy this file to `env` (no leading dot, gitignored) and fill in the real
# values for your deployment. The deploy script reads `env` to render the
# templated config files before rsyncing to the production server.

# Domain — apex hostname of this deployment
DOMAIN=nyingarn.net

# Let's Encrypt registration email
ACME_EMAIL=admin@example.com

# Postgres
DB_PASSWORD=

# Internal versitygw (S3) root credentials
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Real AWS (Textract)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2

# UI / API secrets
MAPBOX_TOKEN=
SESSION_SECRET=

# Google OIDC
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AAF OIDC
AAF_CLIENT_ID=
AAF_CLIENT_SECRET=

# Administrator emails — JSON array literal. Wrap the whole value in single
# quotes so bash preserves the embedded double quotes when sourcing this file.
ADMINISTRATORS='["alice@example.com","bob@example.com"]'

# SMTP — SMTP_SECURE is true for implicit TLS (port 465) and false for
# plaintext or STARTTLS (ports 25 / 587). SMTP_USER and SMTP_PASSWORD may be
# left empty for a relay that doesn't require authentication.
SMTP_HOST=email-smtp.ap-southeast-2.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_SOURCE_EMAIL=nyingarnproject@gmail.com
SMTP_REPLY_TO='["nyingarn-project@unimelb.edu.au"]'
