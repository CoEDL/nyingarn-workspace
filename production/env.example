# Copy this file to `env` (no leading dot, gitignored) and fill in the real
# values for your deployment. The deploy script reads `env` to render the
# templated files before rsyncing to the production server. Everything that
# isn't a secret lives in production/configuration/prod.json.

# Domain — apex hostname of this deployment, used by traefik and nginx.
# Must match the domain in prod.json.
DOMAIN=nyingarn.net

# Let's Encrypt registration email
ACME_EMAIL=admin@example.com

# Postgres
DB_PASSWORD=

# Internal versitygw (S3) root credentials
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Real AWS (Textract)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Signs login sessions. Must be 32 characters or longer.
SESSION_SECRET=

# RabbitMQ — leave empty to use guest/guest
RABBIT_USER=
RABBIT_PASS=
